<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
    <PublishTrimmed>false</PublishTrimmed>
    <BlazorWebAssemblyLoadAllGlobalizationData>true</BlazorWebAssemblyLoadAllGlobalizationData>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../DspNetEnergy.Core/DspNetEnergy.Core.csproj" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.13" PrivateAssets="all" />
    <PackageReference Include="AssetsTools.NET" Version="3.0.5" />
    <EmbeddedResource Include="../DspNetEnergy.Desktop/Assets/inventory.json" LogicalName="inventory.json" />
    <EmbeddedResource Include="../DspNetEnergy.Desktop/Assets/zh-CN.json" LogicalName="zh-CN.json" />
    <EmbeddedResource Include="WebTranslations.json" LogicalName="WebTranslations.json" />
    <Content Include="../DspNetEnergy.Desktop/Assets/AssetsTools.NET.LICENSE.txt" Link="wwwroot/licenses/AssetsTools.NET.LICENSE.txt" />
    <Content Include="../DspNetEnergy.Core/GameData/FactorioLab.LICENSE.txt" Link="wwwroot/licenses/FactorioLab.LICENSE.txt" />
    <ServiceWorker Include="wwwroot/service-worker.js" PublishedContent="wwwroot/service-worker.published.js" />
  </ItemGroup>
  <ItemGroup Condition="'$(DspBrowserTests)' == 'true'">
    <Compile Include="../../tests/DspNetEnergy.WebParity/Scenarios.cs" Link="Tests/Scenarios.cs" />
    <Compile Include="../../tests/DspNetEnergy.WebParity/BrowserParity.cs" Link="Tests/BrowserParity.cs" />
  </ItemGroup>
</Project>
